generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String // จะเก็บ bcrypt hash ไม่ใช่ plain text อีกต่อไป
  role     String @default("user") // "user" หรือ "admin"
}

model Message {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  message   String
  authorId  String?   // ← เพิ่มใหม่ ใช้ตรวจ Authorization ใน L4
  tag       String?  // ← เพิ่มใหม่
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  post      Message  @relation(fields: [postId], references: [id])
  reactions Reaction[]
  reactionsCount Int @default(0) // ← เพิ่มใหม่ (ฝั่ง UI)
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String   // เช่น "👍" หรือ "❤️"
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())
}
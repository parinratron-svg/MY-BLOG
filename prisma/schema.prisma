generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String // จะเก็บ bcrypt hash ไม่ใช่ plain text อีกต่อไป
  
}

model Message {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  message   String
  authorId  String?   // ← เพิ่มใหม่ ใช้ตรวจ Authorization ใน L4

  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  authorId  String?  // ← เพิ่มใหม่ ใช้ตรวจ Authorization   content   String 
  content   String
  createdAt DateTime @default(now())
  post      Message  @relation(fields: [postId], references: [id])
}